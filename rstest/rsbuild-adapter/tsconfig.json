{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./src/*"],
      "@utils/*": ["./src/utils/*"]
    },
    "types": ["@rsbuild/core/types", "node", "@rstest/core"]
  },
  "include": ["src", "tests", "rstest.config.ts", "rsbuild.config.ts"]
}
